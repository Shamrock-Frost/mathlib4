module

public import Mathlib.Algebra.Module.Submodule.Invariant
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Action of the multivariate polynomial ring on a module induced by elements of an algebra.

Given an interpretation `T : σ → A` of our variables in a commutative
`R`-algebra `A` and an `A`-module `M` we define an `MvPolynomial σ R`-module
`Module.MvAEval R M T`, which is a type synonym of `M` with the action of a
polynomial `f` given by `f • m = MvPolynomial.aeval T f • m`.
In particular `X i • m = T i • m`.

As a special case of this, given an `R`-module `M`, a family of endomorphisms
`Φ : σ → M →ₗ[R] M`, and a proof `h` that the `Φ i` pairwise commute we define
a type synonym `Module.MvAEval' Φ h` for `M` carrying the `MvPolynomial σ R`-module
structure in which `X i • m = Φ i m`. Since the endomorphism ring is in general
not a commutative algebra we must pass the subring of it generated by the `Φ i`.
In order to define a commutative algebra structure on this we need to include
the proof `h` at the type level, which is why we use the auxiliary definition
`MvAEval'.auxRing`.
-/

@[expose] public section

open Set Function MvPolynomial

namespace Module

/--
Suppose `σ` is an indexing type, `T : σ → A` a `σ`-indexed family of elements
of an `R`-algebra `A` and `M` is an `A`-module. Loosely speaking,
`Module.MvAEval R M T` is the `MvPolynomial σ R`-module with elements `m : M`,
where the action of a polynomial $f$ is given by $f • m = f(X i ↦ T i) • m$.

More precisely, `Module.MvAEval R M T` has elements `Module.MvAEval.of R M T m`
for `m : M`, and the action of `f` is `f • of R M T m = of R M T (aeval T f • m)`.
-/
@[nolint unusedArguments]
def MvAEval (R M : Type*) {A σ : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
    [AddCommMonoid M] [Module A M] [Module R M] [IsScalarTower R A M] (_ : σ → A) := M
  deriving AddCommMonoid, Module R

instance MvAEval.instAddCommGroup {R A M σ : Type*} [CommSemiring R] [CommSemiring A]
    (T : σ → A) [Algebra R A] [AddCommGroup M] [Module A M] [Module R M]
    [IsScalarTower R A M] : AddCommGroup <| MvAEval R M T :=
  inferInstanceAs (AddCommGroup M)

variable {R A M σ : Type*} [CommSemiring R] [CommSemiring A] (T : σ → A) [Algebra R A]
  [AddCommMonoid M] [Module A M] [Module R M] [IsScalarTower R A M]

namespace MvAEval

instance instFiniteOrig [Module.Finite R M] : Module.Finite R <| MvAEval R M T :=
  inferInstanceAs <| Module.Finite R M

noncomputable instance instModulePolynomial : Module (MvPolynomial σ R) <| MvAEval R M T :=
  compHom M (aeval T).toRingHom

variable (R M) in
/--
The canonical linear equivalence between `M` and `Module.MvAEval R M T` as an `R`-module.
-/
def of : M ≃ₗ[R] MvAEval R M T :=
  LinearEquiv.refl _ _

lemma of_aeval_smul (f : MvPolynomial σ R) (m : M) :
    of R M T (aeval T f • m) = f • of R M T m := rfl

@[simp] lemma of_symm_smul (f : MvPolynomial σ R) (m : MvAEval R M T) :
    (of R M T).symm (f • m) = aeval T f • (of R M T).symm m := rfl

@[simp] lemma C_smul (c : R) (m : MvAEval R M T) : (C c : MvPolynomial σ R) • m = c • m :=
  (of R M T).symm.injective <| by simp

lemma X_smul_of (i : σ) (m : M) :
    (X i : MvPolynomial σ R) • of R M T m = of R M T (T i • m) := by
  rw [← of_aeval_smul, aeval_X]

lemma X_pow_smul_of (i : σ) (n : ℕ) (m : M) :
    (X i ^ n : MvPolynomial σ R) • of R M T m = of R M T (T i ^ n • m) := by
  rw [← of_aeval_smul, map_pow, aeval_X]

lemma of_symm_X_smul (i : σ) (m : MvAEval R M T) :
    (of R M T).symm ((X i : MvPolynomial σ R) • m) = T i • (of R M T).symm m := by
  rw [of_symm_smul, aeval_X]

instance instIsScalarTowerOrigPolynomial : IsScalarTower R (MvPolynomial σ R) <| MvAEval R M T where
  smul_assoc r f m := by
    apply (of R M T).symm.injective
    rw [of_symm_smul, map_smul, smul_assoc, map_smul, of_symm_smul]

instance instFinitePolynomial [Module.Finite R M] :
    Module.Finite (MvPolynomial σ R) <| MvAEval R M T :=
  Finite.of_restrictScalars_finite R _ _

/-- Construct an `MvPolynomial σ R`-linear map out of `MvAEval R M T` from an
`R`-linear map out of `M`. -/
def _root_.LinearMap.ofMvAEval {N : Type*} [AddCommMonoid N] [Module R N]
    [Module (MvPolynomial σ R) N] [IsScalarTower R (MvPolynomial σ R) N]
    (f : M →ₗ[R] N) (hf : ∀ i m, f (T i • m) = (X i : MvPolynomial σ R) • f m) :
    MvAEval R M T →ₗ[MvPolynomial σ R] N where
  __ := f ∘ₗ (of R M T).symm
  map_smul' p m := by
    suffices H : ∀ m : M, f (aeval T p • m) = p • f m from H _
    induction p using MvPolynomial.induction_on with
    | C r => intro m; rw [aeval_C, algebraMap_smul, f.map_smul, ← algebraMap_eq, algebraMap_smul]
    | add p q hp hq => intro m; rw [map_add, add_smul, add_smul, map_add, hp, hq]
    | mul_X p i ih => intro m; rw [map_mul, aeval_X, mul_smul, mul_smul, ih, hf]

lemma annihilator_eq_ker_aeval [FaithfulSMul A M] :
    annihilator (MvPolynomial σ R) (MvAEval R M T) = RingHom.ker (aeval T) := by
  ext p
  simp_rw [mem_annihilator, RingHom.mem_ker]
  change (∀ m : M, aeval T p • m = 0) ↔ _
  exact ⟨fun h ↦ eq_of_smul_eq_smul (α := M) <| by simp [h], fun h ↦ by simp [h]⟩

@[simp]
lemma annihilator_top_eq_ker_aeval [FaithfulSMul A M] :
    (⊤ : Submodule (MvPolynomial σ R) <| MvAEval R M T).annihilator = RingHom.ker (aeval T) :=
  Submodule.annihilator_top.trans (annihilator_eq_ker_aeval T)

section Submodule

variable (R M)

/-- The `R`-submodules of `M` which are invariant under each `T i`. -/
abbrev invtSubmodule : Sublattice (Submodule R M) :=
  ⨅ i, (Algebra.lsmul R R M (T i)).invtSubmodule

variable {R M T} in
lemma mem_invtSubmodule {p : Submodule R M} :
    p ∈ invtSubmodule R M T ↔ ∀ i, p ≤ p.comap (Algebra.lsmul R R M (T i)) := by
  simp [invtSubmodule, Module.End.mem_invtSubmodule]

set_option backward.isDefEq.respectTransparency false in
/-- An `R`-submodule which is stable under the actions of the `T i` can be
promoted to an `MvPolynomial σ R`-submodule, and conversely we can turn an
`MvPolynomial σ R`-submodule into an `R`-submodule by forgetting the action of `X`.
These operations are inverse order isomorphisms. -/
noncomputable def mapSubmodule :
    invtSubmodule R M T ≃o Submodule (MvPolynomial σ R) (MvAEval R M T) where
  toFun p :=
    { toAddSubmonoid := (p : Submodule R M).toAddSubmonoid.map (of R M T)
      smul_mem' := by
        rintro f - ⟨m : M, h : m ∈ (p : Submodule R M), rfl⟩
        have hp := mem_invtSubmodule.mp p.2
        simp only [AddSubsemigroup.mem_carrier, AddSubmonoid.mem_toSubsemigroup,
          AddSubmonoid.mem_map, Submodule.mem_toAddSubmonoid]
        refine ⟨aeval T f • m, ?_, of_aeval_smul T f m⟩
        induction f using MvPolynomial.induction_on generalizing m with
        | C r => simpa using (p : Submodule R M).smul_mem r h
        | add f g hf hg => simpa [add_smul] using (p : Submodule R M).add_mem (hf m h) (hg m h)
        | mul_X f i ih => rw [map_mul, aeval_X, mul_smul]; exact ih (T i • m) (hp i h) }
  invFun q := ⟨(Submodule.orderIsoMapComap (of R M T)).symm (q.restrictScalars R),
    mem_invtSubmodule.mpr fun i m (hm : of R M T m ∈ q) ↦
      show of R M T (T i • m) ∈ q from X_smul_of (R := R) T i m ▸ q.smul_mem _ hm⟩
  left_inv p := by ext; simp
  right_inv q := by ext; aesop
  map_rel_iff' {p p'} := ⟨fun h x hx ↦ by aesop (rule_sets := [SetLike!]), fun h x hx ↦ by aesop⟩

@[simp] lemma mem_mapSubmodule_apply {p : invtSubmodule R M T} {m : MvAEval R M T} :
    m ∈ mapSubmodule R M T p ↔ (of R M T).symm m ∈ (p : Submodule R M) :=
  ⟨fun ⟨_, hm, hm'⟩ ↦ hm'.symm ▸ hm, fun hm ↦ ⟨(of R M T).symm m, hm, rfl⟩⟩

@[simp] lemma mem_mapSubmodule_symm_apply {q : Submodule (MvPolynomial σ R) (MvAEval R M T)}
    {m : M} : m ∈ ((mapSubmodule R M T).symm q : Submodule R M) ↔ of R M T m ∈ q :=
  Iff.rfl

end Submodule

end MvAEval

section MvAEval'

variable (Φ : σ → M →ₗ[R] M) (h : Pairwise fun i j ↦ Commute (Φ i) (Φ j))

/-- A type synonym for `Algebra.adjoin R (range Φ)`. Since the proof that
the various `Φ i` commute is in the type we can define a `CommSemiring` instance. -/
@[nolint unusedArguments]
def MvAEval'.auxRing (_ : Pairwise fun i j ↦ Commute (Φ i) (Φ j)) : Subalgebra R (M →ₗ[R] M) :=
  Algebra.adjoin R (range Φ)

lemma MvAEval'.auxRing_isMulCommutative : IsMulCommutative (MvAEval'.auxRing Φ h) :=
  Algebra.isMulCommutative_adjoin R <| by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hij
    exact h fun hij' ↦ hij (congrArg Φ hij')

open scoped IsMulCommutative in
noncomputable instance : CommSemiring (MvAEval'.auxRing Φ h) :=
  have := MvAEval'.auxRing_isMulCommutative Φ h
  inferInstance

/-- The family `Φ`, viewed as a family of elements of the commutative ring
`Module.MvAEval'.auxRing Φ h`. -/
def MvAEval'.auxFamily (i : σ) : MvAEval'.auxRing Φ h :=
  ⟨Φ i, Algebra.subset_adjoin <| mem_range_self i⟩

/--
Given an `R`-module `M`, a family of linear maps `Φ : σ → M →ₗ[R] M`, and a
proof `h` that the maps in the family pairwise commute, `Module.MvAEval' Φ h`
is loosely speaking the `MvPolynomial σ R`-module with elements `m : M`, where
the action of a polynomial $f$ is given by $f • m = f(X i ↦ Φ i) • m$.
We can't define this directly in terms of `MvAEval` and `Φ` like in the
univariate case, since `aeval` for multivariate polynomials only works for
commutative algebras (the univariate polynomial ring is the free algebra on one
generator, but the multivariate polynomial ring on `σ` is only the free
*commutative* algebra on `σ`). So we use `aeval` with `Φ` modified so that its
codomain is restricted to the `R`-subalgebra of `M →ₗ[R] M` generated by `Φ`.

`Module.MvAEval'` is defined as a special case of `Module.MvAEval` in which the
`R`-algebra is `Algebra.adjoin R (range Φ)`. We use a type synonym
`MvAEval'.auxRing Φ h` which includes the proof `h` so that a `CommSemiring`
instance may be defined. -/
abbrev MvAEval' := MvAEval R M (MvAEval'.auxFamily Φ h)

namespace MvAEval'

/-- The canonical linear equivalence between `M` and `Module.MvAEval' Φ h` as an `R`-module. -/
noncomputable abbrev of : M ≃ₗ[R] MvAEval' Φ h := MvAEval.of R M _

variable {Φ h}

lemma X_smul_of (i : σ) (m : M) :
    (X i : MvPolynomial σ R) • of Φ h m = of Φ h (Φ i m) :=
  MvAEval.X_smul_of _ i m

lemma of_symm_X_smul (i : σ) (m : MvAEval' Φ h) :
    (of Φ h).symm ((X i : MvPolynomial σ R) • m) = Φ i ((of Φ h).symm m) :=
  MvAEval.of_symm_X_smul _ i m

end MvAEval'

end MvAEval'

end Module
